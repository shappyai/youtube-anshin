  "subtitles": [
    {"id": "SUB-001", "text_lines": ["朝は100%だったのに、", "夕方にはかなり減っている。"], "segment_id": 1, "font_px": 60},
    {"id": "SUB-002", "text_lines": ["バッテリーの寿命かもと、", "すぐ交換を考えてしまいます。"], "segment_id": 2, "font_px": 60},
    {"id": "SUB-003", "text_lines": ["その前に、iPhoneの中で", "原因の手がかりを確認できます。"], "segment_id": 3, "font_px": 60},
    {"id": "SUB-004", "text_lines": ["節電設定を変える前に、", "まず3か所を確認します。"], "segment_id": 4, "font_px": 60},
    {"id": "SUB-005", "text_lines": ["1つ目は、何が電池を使っているか。", "2つ目は画面、3つ目は状態。"], "segment_id": 5, "font_px": 60},
    {"id": "SUB-006", "text_lines": ["1つ目は、バッテリー使用状況の内訳です。"], "segment_id": 6, "font_px": 60},
    {"id": "SUB-007", "text_lines": ["「設定」→「バッテリー」"], "segment_id": 7, "font_px": 60},
    {"id": "SUB-008", "text_lines": ["「1日の使用状況」のグラフと、", "アクティビティを確認します。"], "segment_id": 8, "font_px": 60},
    {"id": "SUB-009", "text_lines": ["上位のアプリやシステムを確認し、", "使った時間と照らし合わせます。"], "segment_id": 9, "font_px": 60},
    {"id": "SUB-010", "text_lines": ["上位にあるだけで、", "故障とは決めません。"], "segment_id": 10, "font_px": 60},
    {"id": "SUB-011", "text_lines": ["アプリごとの詳細で、", "「画面上」「バックグラウンド」を確認。"], "segment_id": 11, "font_px": 60},
    {"id": "SUB-012", "text_lines": ["「画面上」は表示していた時間、", "「バックグラウンド」は裏の処理の手がかり。"], "segment_id": 12, "font_px": 60},
    {"id": "SUB-013", "text_lines": ["「圏外や低信号」「通知」が", "表示される場合もあります。"], "segment_id": 13, "font_px": 60},
    {"id": "SUB-014", "text_lines": ["表示を見て原因候補を絞り、", "いきなり全部オフにしません。"], "segment_id": 14, "font_px": 60},
    {"id": "SUB-015", "text_lines": ["iOS更新直後は、", "数日待ってから再確認します。"], "segment_id": 15, "font_px": 60},
    {"id": "SUB-016", "text_lines": ["2つ目は、", "画面の設定です。"], "segment_id": 16, "font_px": 60},
    {"id": "SUB-017", "text_lines": ["「設定」→「画面表示と明るさ」"], "segment_id": 17, "font_px": 60},
    {"id": "SUB-018", "text_lines": ["「明るさ」と「自動ロック」を", "確認します。"], "segment_id": 18, "font_px": 60},
    {"id": "SUB-019", "text_lines": ["暗くしすぎたり短くしすぎると、", "使いにくくなることがあります。"], "segment_id": 19, "font_px": 60},
    {"id": "SUB-020", "text_lines": ["変える場合も、", "必要なものを1つだけ試します。"], "segment_id": 20, "font_px": 60},
    {"id": "SUB-021", "text_lines": ["この動画では、", "設定を一括で変えません。"], "segment_id": 21, "font_px": 60},
    {"id": "SUB-022", "text_lines": ["3つ目は、バッテリーそのものの状態です。"], "segment_id": 22, "font_px": 60},
    {"id": "SUB-023", "text_lines": ["iPhone 12 miniでは、", "「バッテリーの状態と充電」"], "segment_id": 23, "font_px": 60},
    {"id": "SUB-024", "text_lines": ["「最大容量」と、", "注意表示がないかを確認します。"], "segment_id": 24, "font_px": 60},
    {"id": "SUB-025", "text_lines": ["最大容量は、", "新品時と比べた容量の目安です。"], "segment_id": 25, "font_px": 60},
    {"id": "SUB-026", "text_lines": ["注意表示がある場合は、", "Appleの案内を読み相談を検討します。"], "segment_id": 26, "font_px": 60},
    {"id": "SUB-027", "text_lines": ["数字だけで、", "交換必須や故障とは決めません。"], "segment_id": 27, "font_px": 60},
    {"id": "SUB-028", "text_lines": ["まとめ：まず、3か所を確認します。"], "segment_id": 28, "font_px": 60},
    {"id": "SUB-029", "text_lines": ["1つ目、バッテリーで", "何が使っているかを見る。"], "segment_id": 29, "font_px": 60},
    {"id": "SUB-030", "text_lines": ["2つ目、画面表示と明るさで", "明るさと自動ロックを確認する。"], "segment_id": 30, "font_px": 60},
    {"id": "SUB-031", "text_lines": ["3つ目、状態と充電で", "最大容量と注意表示を見る。"], "segment_id": 31, "font_px": 60},
    {"id": "SUB-032", "text_lines": ["通知・位置情報・バックグラウンド更新を", "まとめてオフにしません。"], "segment_id": 32, "font_px": 60},
    {"id": "SUB-033", "text_lines": ["更新直後や発熱の後は、", "数日たっても続けば相談します。"], "segment_id": 33, "font_px": 60},
    {"id": "SUB-034", "text_lines": ["原因候補を一つずつ", "切り分けられれば十分です。"], "segment_id": 34, "font_px": 60}
  ],
