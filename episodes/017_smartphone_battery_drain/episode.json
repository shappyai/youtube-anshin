  "narration_segments": [
    {"id": 1, "section": "はじめに", "narration": "最近、朝は100%だったのに、夕方には充電がかなり減っている。そんなことはありませんか。", "reading_overrides": {"100%": "ひゃくパーセント"}, "pause_after": 0.35, "scene_id": 1, "subtitle_ids": ["SUB-001"]},
    {"id": 2, "section": "はじめに", "narration": "「バッテリーの寿命かもしれない」と、すぐに交換を考えたくなります。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 1, "subtitle_ids": ["SUB-002"]},
    {"id": 3, "section": "はじめに", "narration": "でも、その前にiPhoneの中で、原因の手がかりを確認できます。", "reading_overrides": {"iPhone": "アイフォーン"}, "pause_after": 0.25, "scene_id": 1, "subtitle_ids": ["SUB-003"]},
    {"id": 4, "section": "はじめに", "narration": "今日は、節電設定を片っ端から変えずに、まず見る3か所だけを一緒に確認します。", "reading_overrides": {"今日": "きょう"}, "pause_after": 0.25, "scene_id": 2, "subtitle_ids": ["SUB-004"]},
    {"id": 5, "section": "はじめに", "narration": "1つ目は、何がバッテリーを使っているか。2つ目は、画面の設定。3つ目は、バッテリーの状態です。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 2, "subtitle_ids": ["SUB-005"]},
    {"id": 6, "section": "1", "narration": "1つ目は、バッテリー使用状況の内訳です。", "reading_overrides": {}, "pause_after": 0.2, "scene_id": 3, "subtitle_ids": ["SUB-006"]},
    {"id": 7, "section": "1", "narration": "「設定」を開き、「バッテリー」をタップします。", "reading_overrides": {}, "pause_after": 0.2, "scene_id": 4, "subtitle_ids": ["SUB-007"]},
    {"id": 8, "section": "1", "narration": "ここに「1日の使用状況」のグラフや、アプリとシステムのアクティビティが表示されます。表示の名前や期間は、iOSのバージョンで違う場合があります。", "reading_overrides": {"iOS": "アイオーエス"}, "pause_after": 0.3, "scene_id": 5, "subtitle_ids": ["SUB-008"]},
    {"id": 9, "section": "1", "narration": "上位に表示されたアプリを、まず確認します。ここで見るのは、順位そのものではなく、使った時間や、その日に何をしていたかとのつながりです。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 5, "subtitle_ids": ["SUB-009"]},
    {"id": 10, "section": "1", "narration": "動画や地図を長く使った日なら、そのアプリが上位でも不思議ではありません。上位にあるだけで、アプリの故障とは決めません。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 6, "subtitle_ids": ["SUB-010"]},
    {"id": 11, "section": "1", "narration": "アプリごとの詳細には、「画面上」「バックグラウンド」など、使われ方の手がかりが表示されます。端末や状況によって、圏外や低信号、通知などが表示される場合もあります。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 6, "subtitle_ids": ["SUB-011"]},
    {"id": 12, "section": "1", "narration": "「画面上」が長ければ、アプリを開いて画面に表示していた時間が長かった可能性があります。「バックグラウンド」は、画面に表示していない間の処理などが続いていた可能性を示します。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 6, "subtitle_ids": ["SUB-012"]},
    {"id": 13, "section": "1", "narration": "「圏外や低信号」は、電波を探していたことの手がかりです。「通知」は、通知でiPhoneのスリープが解除された可能性があります。", "reading_overrides": {"iPhone": "アイフォーン"}, "pause_after": 0.25, "scene_id": 7, "subtitle_ids": ["SUB-013"]},
    {"id": 14, "section": "1", "narration": "ここで大切なのは、表示を見て原因候補を絞ることです。通知や位置情報を、いきなり全部オフにはしません。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 7, "subtitle_ids": ["SUB-014"]},
    {"id": 15, "section": "1", "narration": "最近iOSを更新した直後なら、バックグラウンドで更新後の処理が続き、しばらく減りが早く見えることがあります。画面にその案内があれば、数日たってからもう一度確認します。", "reading_overrides": {"iOS": "アイオーエス"}, "pause_after": 0.35, "scene_id": 7, "subtitle_ids": ["SUB-015"]},
    {"id": 16, "section": "2", "narration": "2つ目は、画面の設定です。1つ目で「画面オン」が長かったときに確認します。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 8, "subtitle_ids": ["SUB-016"]},
    {"id": 17, "section": "2", "narration": "「設定」から「画面表示と明るさ」を開きます。", "reading_overrides": {}, "pause_after": 0.2, "scene_id": 9, "subtitle_ids": ["SUB-017"]},
    {"id": 18, "section": "2", "narration": "「明るさ」が高すぎないか、「自動ロック」が長すぎたり、オフになったりしていないかを確認します。機種によって表示される項目は異なります。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 9, "subtitle_ids": ["SUB-018"]},
    {"id": 19, "section": "2", "narration": "ただし、画面を暗くしすぎる必要はありません。文字が読みにくくなれば、かえって使いにくくなります。自動ロックを短くしすぎると、読んでいる途中で画面が消えることもあります。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 10, "subtitle_ids": ["SUB-019"]},
    {"id": 20, "section": "2", "narration": "設定を変える場合も、明るさや自動ロックなど、必要なものを1つだけ試します。この動画では、確認だけにして、全員に同じ変更は勧めません。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 10, "subtitle_ids": ["SUB-020"]},
    {"id": 21, "section": "2", "narration": "この動画では、設定を一括で変えず、今の表示を確認するだけで大丈夫です。機種によって表示されない項目は、無理に探しません。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 11, "subtitle_ids": ["SUB-021"]},
    {"id": 22, "section": "3", "narration": "3つ目は、バッテリーそのものの状態です。", "reading_overrides": {}, "pause_after": 0.2, "scene_id": 12, "subtitle_ids": ["SUB-022"]},
    {"id": 23, "section": "3", "narration": "今回のiPhone 12 miniでは、「設定」から「バッテリー」、「バッテリーの状態と充電」と進みます。別の機種では、入口の名前が異なる場合があります。", "reading_overrides": {"iPhone": "アイフォーン"}, "pause_after": 0.25, "scene_id": 13, "subtitle_ids": ["SUB-023"]},
    {"id": 24, "section": "3", "narration": "ここでは、まず「最大容量」と、「サービス」などの注意表示がないかを確認します。今回の画面に表示された名前を正として案内します。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 13, "subtitle_ids": ["SUB-024"]},
    {"id": 25, "section": "3", "narration": "最大容量は、新品のときと比べたバッテリー容量の目安です。数字だけを見て、「この割合なら必ず交換」とは判断しません。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 13, "subtitle_ids": ["SUB-025"]},
    {"id": 26, "section": "3", "narration": "「サービス」などの注意表示が出ている場合は、Appleの案内を読み、正規サービスへの相談を検討します。数字だけで、交換必須や故障とは決めません。", "reading_overrides": {"Apple": "アップル"}, "pause_after": 0.3, "scene_id": 14, "subtitle_ids": ["SUB-026"]},
    {"id": 27, "section": "3", "narration": "つまり、この画面は交換を決めるボタンではなく、バッテリーの状態を確認する場所です。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 14, "subtitle_ids": ["SUB-027"]},
    {"id": 28, "section": "まとめ", "narration": "まとめです。朝100%から夕方にかなり減ったときは、まず3か所を確認します。", "reading_overrides": {"100%": "ひゃくパーセント"}, "pause_after": 0.3, "scene_id": 15, "subtitle_ids": ["SUB-028"]},
    {"id": 29, "section": "まとめ", "narration": "1つ目、設定のバッテリーで、何が使っているかを見る。", "reading_overrides": {}, "pause_after": 0.2, "scene_id": 15, "subtitle_ids": ["SUB-029"]},
    {"id": 30, "section": "まとめ", "narration": "2つ目、画面表示と明るさで、明るさと自動ロックを確認する。", "reading_overrides": {}, "pause_after": 0.2, "scene_id": 15, "subtitle_ids": ["SUB-030"]},
    {"id": 31, "section": "まとめ", "narration": "3つ目、バッテリーの状態と充電で、最大容量や注意表示を見る。", "reading_overrides": {}, "pause_after": 0.25, "scene_id": 15, "subtitle_ids": ["SUB-031"]},
    {"id": 32, "section": "まとめ", "narration": "アプリのバックグラウンド、通知、位置情報、バックグラウンド更新を、まとめてオフにする必要はありません。まず表示を確認し、必要な変更だけを考えます。", "reading_overrides": {}, "pause_after": 0.3, "scene_id": 15, "subtitle_ids": ["SUB-032"]},
    {"id": 33, "section": "まとめ", "narration": "更新直後や、端末が熱くなった後は、一時的に減りが早く見えることもあります。数日たっても続く場合は、機種、iOSのバージョン、使ったアプリ、表示された内容をメモして、Appleや正規サービスへ相談しましょう。", "reading_overrides": {"iOS": "アイオーエス", "Apple": "アップル"}, "pause_after": 0.35, "scene_id": 15, "subtitle_ids": ["SUB-033"]},
    {"id": 34, "section": "まとめ", "narration": "今日の確認で、原因の候補を一つずつ切り分けられれば十分です。", "reading_overrides": {"今日": "きょう"}, "pause_after": 0.5, "scene_id": 15, "subtitle_ids": ["SUB-034"]}
  ],
