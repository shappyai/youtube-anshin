      "pause_after": 0.16,
      "scene_id": 8,
      "subtitle_ids": [
        "SUB-036",
        "SUB-037"
      ]
    },
    {
      "id": 26,
      "section": "3",
      "narration": "3、登録されているパスキーです。",
      "reading_overrides": {},
      "pause_after": 0.15,
      "scene_id": 9,
      "subtitle_ids": [
        "SUB-038"
      ]
    },
    {
      "id": 27,
      "section": "3",
      "narration": "パスキーは、スマホやパソコンの画面ロック、指紋、顔認証などを使って、パスワードの代わりにログインする方法です。",
      "reading_overrides": {},
      "pause_after": 0.14,
      "scene_id": 10,
      "subtitle_ids": [
        "SUB-039",
        "SUB-040"
      ]
    },
    {
      "id": 28,
      "section": "3",
      "narration": "パスキーを使うと、場合によっては2段階目の確認を省いてログインできます。これは、2段階認証をオフにすることとは別の仕組みです。",
      "reading_overrides": {},
      "pause_after": 0.16,
      "scene_id": 10,
      "subtitle_ids": [
        "SUB-041",
        "SUB-042",
        "SUB-043"
      ]
    },
    {
      "id": 29,
      "section": "3",
      "narration": "大事なのは、自分が持っていて、画面ロックをかけている端末にだけ登録されているかを確認することです。",
      "reading_overrides": {},
      "pause_after": 0.16,
      "scene_id": 10,
      "subtitle_ids": [
        "SUB-044",
        "SUB-045"
      ]
    },
    {
      "id": 30,
      "section": "3",
      "narration": "Googleアカウントの「パスキーとセキュリティ キー」の場所を開きます。",
      "reading_overrides": {},
      "pause_after": 0.14,
      "scene_id": 10,
      "subtitle_ids": [
        "SUB-046"
      ]
    },
    {
      "id": 31,
      "section": "3",
      "narration": "Androidスマホでは、端末の設定などによって、パスキーが自動的に登録されることがあります。表示された端末名を確認します。",
      "reading_overrides": {},
      "pause_after": 0.16,
      "scene_id": 10,
      "subtitle_ids": [
        "SUB-047",
        "SUB-048"
      ]
    },
    {
      "id": 32,
      "section": "3",
      "narration": "今も自分が使っている端末なら、そのままで構いません。古い端末や共有の端末があれば、登録を見直します。",
      "reading_overrides": {},
      "pause_after": 0.14,
      "scene_id": 10,
      "subtitle_ids": [
        "SUB-049",
        "SUB-050"
      ]
    },
    {
      "id": 33,
      "section": "3",
      "narration": "新しく登録するときは、自分が所有し、画面ロックを設定している端末だけを使います。",
      "reading_overrides": {},
      "pause_after": 0.15,
      "scene_id": 10,
      "subtitle_ids": [
        "SUB-051"
      ]
    },
    {
      "id": 34,
      "section": "3",
      "narration": "使っていない端末を見つけた場合も、名前だけで判断せず、公式の説明を確認してから削除を考えます。",
      "reading_overrides": {},
      "pause_after": 0.16,
      "scene_id": 11,
      "subtitle_ids": [
        "SUB-052"
      ]
    },
    {
      "id": 35,
      "section": "3",
      "narration": "パスワードを使わずにログインする設定が表示される場合もあります。内容を理解していないまま、変更を急がなくて大丈夫です。",
      "reading_overrides": {},
      "pause_after": 0.16,
      "scene_id": 11,
      "subtitle_ids": [
        "SUB-053",
        "SUB-054"
      ]
    },
    {
      "id": 36,
      "section": "3",
      "narration": "パスキーは便利な方法ですが、登録先を確認して、自分の端末だけになっているかを見ておきましょう。",
      "reading_overrides": {},
      "pause_after": 0.16,
      "scene_id": 11,
      "subtitle_ids": [
        "SUB-055"
      ]
    },
    {
      "id": 37,
      "section": "まとめ",
      "narration": "まとめです。1つ目、いつもの確認方法。",
      "reading_overrides": {},
      "pause_after": 0.14,
      "scene_id": 12,
      "subtitle_ids": [
        "SUB-056"
      ]
    },
    {
      "id": 38,
      "section": "まとめ",
      "narration": "2つ目、スマホが使えないときの予備。",
      "reading_overrides": {},
      "pause_after": 0.14,
      "scene_id": 12,
      "subtitle_ids": [
        "SUB-057"
      ]
    },
    {
      "id": 39,
      "section": "まとめ",
      "narration": "3つ目、登録されているパスキーとセキュリティ キー。",
      "reading_overrides": {},
      "pause_after": 0.14,
