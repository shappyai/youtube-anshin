  "subtitles": [
    {
      "id": "SUB-001",
      "text_lines": [
        "LINEが最近重い、容量が大きいと感じても、",
        "いきなり写真やトークを消す必要はありません。"
      ],
      "segment_id": 1
    },
    {
      "id": "SUB-002",
      "text_lines": [
        "先に、LINEの中で",
        "何が容量を使っているか確認します。"
      ],
      "segment_id": 2
    },
    {
      "id": "SUB-003",
      "text_lines": [
        "今日は、まず見る場所を",
        "3つに絞ります。"
      ],
      "segment_id": 3
    },
    {
      "id": "SUB-004",
      "text_lines": [
        "1つ目は、LINEのデータの削除画面です。"
      ],
      "segment_id": 4
    },
    {
      "id": "SUB-005",
      "text_lines": [
        "2つ目は、キャッシュです。"
      ],
      "segment_id": 5
    },
    {
      "id": "SUB-006",
      "text_lines": [
        "3つ目は、容量の大きい",
        "トークルームです。"
      ],
      "segment_id": 6
    },
    {
      "id": "SUB-007",
      "text_lines": [
        "必ず速くなるとは限りません。",
        "原因を見てから考えます。"
      ],
      "segment_id": 7
    },
    {
      "id": "SUB-008",
      "text_lines": [
        "空き容量が少ないと表示され、",
        "LINEの写真を消そうか迷うことがあります。"
      ],
      "segment_id": 8
    },
    {
      "id": "SUB-009",
      "text_lines": [
        "スマホ全体の容量と、LINEアプリの容量は",
        "まず分けて考えます。"
      ],
      "segment_id": 9
    },
    {
      "id": "SUB-010",
      "text_lines": [
        "キャッシュやトーク関連のデータがたまると、",
        "LINEが重くなる要因になると公式が案内しています。"
      ],
      "segment_id": 10
    },
    {
      "id": "SUB-011",
      "text_lines": [
        "最初に見るのは削除ボタンではなく、",
        "容量の内訳です。"
      ],
      "segment_id": 11
    },
    {
      "id": "SUB-012",
      "text_lines": [
        "LINEを開き、ホームから",
        "設定を開きます。"
      ],
      "segment_id": 12
    },
    {
      "id": "SUB-013",
      "text_lines": [
        "「トーク」から「データの削除」へ進みます。"
      ],
      "segment_id": 13
    },
    {
      "id": "SUB-014",
      "text_lines": [
        "表示された項目と容量を、",
        "まず確認します。"
      ],
      "segment_id": 14
    },
    {
      "id": "SUB-015",
      "text_lines": [
        "表示名や並ぶ順が異なることがあります。",
        "実際の画面の文字を優先します。"
      ],
      "segment_id": 15
    },
    {
      "id": "SUB-016",
      "text_lines": [
        "この段階では削除しません。",
        "写真を全部消す判断を避けます。"
      ],
      "segment_id": 16
    },
    {
      "id": "SUB-017",
      "text_lines": [
        "スマホ全体の空き容量が少ない場合は、",
        "端末のストレージも別に確認します。"
      ],
      "segment_id": 17
    },
    {
      "id": "SUB-018",
      "text_lines": [
        "次はキャッシュです。"
      ],
      "segment_id": 18
    },
    {
      "id": "SUB-019",
      "text_lines": [
        "キャッシュは、LINEを表示しやすくするために",
        "一時的に保存されるデータです。"
      ],
      "segment_id": 19
    },
    {
      "id": "SUB-020",
      "text_lines": [
        "キャッシュがたまったときは、",
        "削除手順を公式が案内しています。"
      ],
      "segment_id": 20
    },
    {
      "id": "SUB-021",
      "text_lines": [
        "データの削除画面で、",
        "キャッシュの項目を大きく見せます。"
      ],
      "segment_id": 21
    },
    {
      "id": "SUB-022",
      "text_lines": [
        "キャッシュを消しても、",
        "トーク履歴そのものは消えません。"
      ],
      "segment_id": 22
    },
    {
      "id": "SUB-023",
      "text_lines": [
        "古い写真や動画などが見られなくなる場合があります。",
        "「何も影響しない」とは考えないでください。"
      ],
      "segment_id": 23
    },
    {
      "id": "SUB-024",
      "text_lines": [
        "キャッシュの削除と、",
        "写真や動画などの削除は、別の操作です。"
      ],
      "segment_id": 24
    },
    {
      "id": "SUB-025",
      "text_lines": [
        "削除する場合は、消えるものを確認して、",
        "大切なデータを残してから進めます。"
      ],
      "segment_id": 25
    },
    {
      "id": "SUB-026",
      "text_lines": [
        "大切な写真や動画は、先に保存できているか",
        "確認してから進めます。"
      ],
      "segment_id": 26
    },
    {
      "id": "SUB-027",
      "text_lines": [
        "大切な写真や動画は、先に保存できているか",
        "確認してから進めます。"
      ],
      "segment_id": 27
    },
    {
      "id": "SUB-028",
      "text_lines": [
        "最後は、トークルームごとの確認です。"
      ],
      "segment_id": 28
    },
    {
      "id": "SUB-029",
      "text_lines": [
        "「トークごとにデータを削除」を",
        "表示します。"
      ],
      "segment_id": 29
    },
    {
      "id": "SUB-030",
      "text_lines": [
        "開くと、容量の大きいトークから",
        "確認できます。"
      ],
      "segment_id": 30
    },
    {
      "id": "SUB-031",
      "text_lines": [
        "大きいからといって、",
        "消してよいとは限りません。"
      ],
      "segment_id": 31
    },
    {
      "id": "SUB-032",
      "text_lines": [
        "写真・動画・ファイルなど、",
        "残したいものを先に確認します。"
      ],
      "segment_id": 32
    },
    {
      "id": "SUB-033",
      "text_lines": [
        "削除したデータは、",
        "復元できないものがあります。"
      ],
      "segment_id": 33
    },
    {
      "id": "SUB-034",
      "text_lines": [
        "大切な写真や動画は、",
        "保存できているか確認します。"
      ],
      "segment_id": 34
    },
    {
      "id": "SUB-035",
      "text_lines": [
        "削除すると、復元できないものがあります。",
        "あとから元に戻せるとは考えません。"
      ],
      "segment_id": 35
    },
    {
      "id": "SUB-036",
      "text_lines": [
        "何が大きいのか、残したいものはないか、",
        "戻せるかを確認してから判断します。"
      ],
      "segment_id": 36
    },
    {
      "id": "SUB-037",
      "text_lines": [
        "削除するか迷うときは、無理に進めず、",
        "残したいデータを確認してからにします。"
      ],
      "segment_id": 37
    },
    {
      "id": "SUB-038",
      "text_lines": [
        "今日の確認は3つです。"
      ],
      "segment_id": 38
    },
    {
      "id": "SUB-039",
      "text_lines": [
        "1つ目、データの削除画面で、",
        "容量の内訳を見る。"
      ],
      "segment_id": 39
    },
    {
      "id": "SUB-040",
      "text_lines": [
        "2つ目、キャッシュを確認し、",
        "選ぶ場合もキャッシュだけ。"
      ],
      "segment_id": 40
    },
    {
      "id": "SUB-041",
      "text_lines": [
        "3つ目、トークごとの容量を確認し、",
        "消す前に残すものを決める。"
      ],
      "segment_id": 41
    },
    {
      "id": "SUB-042",
      "text_lines": [
        "キャッシュ、トーク履歴、写真、動画、ファイル、",
        "アルバムの中身は、同じものではありません。"
      ],
      "segment_id": 42
    },
    {
      "id": "SUB-043",
      "text_lines": [
        "削除する前に、画面の項目と、",
        "消える可能性のあるものを確認してください。"
      ],
      "segment_id": 43
    },
    {
      "id": "SUB-044",
      "text_lines": [
        "画面に出ている項目を確認し、",
        "残したいデータを保存してから進めましょう。"
      ],
      "segment_id": 44
    }
